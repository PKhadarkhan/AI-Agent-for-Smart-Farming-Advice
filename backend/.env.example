# ─── Smart Farming AI Advisor — Environment Variables ────────────────────────
# Copy this file to .env and fill in your real values.
# NEVER commit .env to version control — it is in .gitignore.
#
# This application uses ONLY IBM Cloud / IBM Granite via watsonx.ai.
# No external APIs (Open-Meteo, data.gov.in, Agmarknet, OpenAI, etc.) are used.

# ── IBM watsonx.ai credentials (all required for AI features) ────────────────

# IBM Cloud API Key — used to obtain IAM Bearer tokens server-side.
# Get from: cloud.ibm.com > Manage > Access (IAM) > API keys > Create
IBM_API_KEY=your_ibm_cloud_api_key_here

# IBM watsonx.ai Project ID — required by the text generation API.
# Get from: cloud.ibm.com > watsonx.ai > Projects > <your project> > Manage > General
IBM_PROJECT_ID=your_watsonx_project_id_here

# IBM watsonx.ai base URL — optional, defaults to Frankfurt (eu-de) region.
# Override for other regions:
#   Frankfurt (eu-de):   https://eu-de.ml.cloud.ibm.com   (default)
#   Dallas (us-south):   https://us-south.ml.cloud.ibm.com
#   Tokyo (jp-tok):      https://jp-tok.ml.cloud.ibm.com
#   London (eu-gb):      https://eu-gb.ml.cloud.ibm.com
# IBM_WATSONX_URL=https://eu-de.ml.cloud.ibm.com

# ── Backward-compatibility alias (if you used the old name) ──────────────────
# GRANITE_PROJECT_ID is still accepted but IBM_PROJECT_ID takes precedence.
# Migrate to IBM_PROJECT_ID as soon as possible.
# GRANITE_PROJECT_ID=your_watsonx_project_id_here

# ── Flask settings (optional) ─────────────────────────────────────────────────
PORT=5000
FLASK_DEBUG=false
